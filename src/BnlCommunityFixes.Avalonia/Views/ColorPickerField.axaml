<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BnlCommunityFixes.Avalonia.Views.ColorPickerField">

    <StackPanel Spacing="4">
        <TextBlock x:Name="FieldLabel" FontSize="11" />
        <Grid ColumnDefinitions="*,6,28">
            <TextBox Grid.Column="0"
                     x:Name="HexBox"
                     Watermark="#RRGGBB"
                     MaxLength="7" />
            <Border Grid.Column="2"
                    x:Name="Swatch"
                    CornerRadius="3"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Cursor="Hand">
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BorderBrush" Value="White" />
                    </Style>
                </Border.Styles>
            </Border>
        </Grid>
    </StackPanel>

</UserControl>
