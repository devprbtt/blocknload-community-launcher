<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BnlCommunityFixes.Avalonia.ViewModels"
        xmlns:v="using:BnlCommunityFixes.Avalonia.Views"
        x:Class="BnlCommunityFixes.Avalonia.Views.FeatureSettingsWindow"
        x:DataType="vm:FeatureSettingsViewModel"
        Title="Feature Settings"
        Width="800" Height="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="14 10 14 10">

        <TextBlock DockPanel.Dock="Top"
                   Text="Settings are written into the local patching config files and rebuilt/applied on next launch."
                   Margin="0 0 0 8" FontSize="11" Foreground="Gray" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,80" Margin="0 10 0 0">
            <TextBlock Grid.Column="0" Text="" />
            <Button Grid.Column="2" Content="Save &amp; Close"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Stretch" Classes="accent" />
        </Grid>

        <TabControl>

            <!-- Crosshair -->
            <TabItem Header="Crosshair">
                <ScrollViewer>
                    <StackPanel Margin="8" Spacing="8">
                        <TextBlock Text="Custom weapon reticle. Colors change by damage state: idle / at full damage range / beyond max range. Size scales the whole reticle, spread controls bloom while firing, line thickness thickens line-based reticles, and gap tightens or loosens crosshair arms." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding CrosshairEnabled}" />
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <v:ColorPickerField Grid.Column="0" Label="Idle color"        ColorHex="{Binding CrosshairIdleColor}" />
                            <v:ColorPickerField Grid.Column="2" Label="Full damage color"  ColorHex="{Binding CrosshairFullDamageColor}" />
                            <v:ColorPickerField Grid.Column="4" Label="Below max color"    ColorHex="{Binding CrosshairBelowMaxColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*,8,*,8,*">
                            <StackPanel Grid.Column="0"><TextBlock Text="Brightness" FontSize="11"/><NumericUpDown Value="{Binding CrosshairBrightness}" Minimum="0.25" Maximum="3" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Size" FontSize="11"/><NumericUpDown Value="{Binding CrosshairSize}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Spread" FontSize="11"/><NumericUpDown Value="{Binding CrosshairSpread}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Alpha" FontSize="11"/><NumericUpDown Value="{Binding CrosshairAlpha}" Minimum="0.1" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*">
                            <StackPanel Grid.Column="0"><TextBlock Text="Line thickness" FontSize="11"/><NumericUpDown Value="{Binding CrosshairLineThickness}" Minimum="0.25" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Gap" FontSize="11"/><NumericUpDown Value="{Binding CrosshairGap}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="220,8,Auto,8,Auto">
                            <StackPanel Grid.Column="0"><TextBlock Text="Shape" FontSize="11"/><ComboBox ItemsSource="{Binding CrosshairShapes}" SelectedItem="{Binding CrosshairShape}" HorizontalAlignment="Stretch" /></StackPanel>
                            <CheckBox Grid.Column="2" Content="Force show in ADS" IsChecked="{Binding CrosshairForceShowInAds}" VerticalAlignment="Bottom" />
                            <CheckBox Grid.Column="4" Content="Hide crosshair" IsChecked="{Binding CrosshairHide}" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- FOV -->
            <TabItem Header="FOV">
                <StackPanel Margin="8" Spacing="6">
                    <TextBlock Text="Overrides the camera field of view and ADS sensitivity. Higher FOV gives a wider view at the cost of less zoom. Weapon model FOV controls how large the gun appears in first-person." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                    <CheckBox Content="Enabled" IsChecked="{Binding FovEnabled}" />
                    <Grid ColumnDefinitions="*,8,*,8,*">
                        <StackPanel Grid.Column="0"><TextBlock Text="FOV" FontSize="11"/><NumericUpDown Value="{Binding Fov}" Minimum="1" Maximum="180" Increment="1" FormatString="0" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="ADS sensitivity" FontSize="11"/><NumericUpDown Value="{Binding AdsSensitivity}" Minimum="0" Maximum="10" Increment="0.05" FormatString="0.00" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Weapon model FOV" FontSize="11"/><NumericUpDown Value="{Binding WeaponModelFov}" Minimum="0" Maximum="180" Increment="1" FormatString="0" /></StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Team Colors -->
            <TabItem Header="Team Colors">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Changes the color of friendly and enemy indicators — nameplates, health bars, hit effects. Use the preset buttons for colors from past community seasons, or pick your own." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                    <CheckBox Content="Enabled" IsChecked="{Binding TeamColorsEnabled}" />
                    <Grid ColumnDefinitions="*,8,*">
                        <v:ColorPickerField Grid.Column="0" Label="Friendly color" ColorHex="{Binding FriendlyColor}" />
                        <v:ColorPickerField Grid.Column="2" Label="Enemy color"    ColorHex="{Binding EnemyColor}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Season presets:" VerticalAlignment="Center" />
                        <Button Content="Beta"    Command="{Binding ApplyBetaColorsCommand}" />
                        <Button Content="Classic" Command="{Binding ApplyClassicColorsCommand}" />
                        <Button Content="Default" Command="{Binding ApplyDefaultColorsCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Damage/Healing -->
            <TabItem Header="Damage/Healing">
                <ScrollViewer>
                    <StackPanel Margin="8" Spacing="8">
                        <TextBlock Text="Customizes floating damage and heal numbers in combat. Combine options merge rapid-fire hits into one number until it fades. Minimum heal filters out heals below the set threshold." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding DamageHealingEnabled}" />
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <v:ColorPickerField Grid.Column="0" Label="Damage color"      ColorHex="{Binding DamageColor}" />
                            <v:ColorPickerField Grid.Column="2" Label="Crit damage color" ColorHex="{Binding CritDamageColor}" />
                            <v:ColorPickerField Grid.Column="4" Label="Heal color"        ColorHex="{Binding HealColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*,8,*,8,*">
                            <StackPanel Grid.Column="0"><TextBlock Text="Damage size" FontSize="11"/><NumericUpDown Value="{Binding DamageSize}" Minimum="0.25" Maximum="10" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Heal size" FontSize="11"/><NumericUpDown Value="{Binding HealSize}" Minimum="0.25" Maximum="10" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Alpha" FontSize="11"/><NumericUpDown Value="{Binding DamageAlpha}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Min heal" FontSize="11"/><NumericUpDown Value="{Binding MinimumHeal}" Minimum="0" Maximum="1000" Increment="1" FormatString="0" /></StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Show friendly healing" IsChecked="{Binding ShowFriendlyHealing}" />
                            <CheckBox Content="Show self healing"     IsChecked="{Binding ShowSelfHealing}" />
                            <CheckBox Content="Combine damage"        IsChecked="{Binding CombineDamage}" />
                            <CheckBox Content="Combine healing"       IsChecked="{Binding CombineHealing}" />
                        </StackPanel>
                        <TextBlock Text="Self-healing numbers" FontWeight="SemiBold" FontSize="11" Margin="0 4 0 0" />
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <StackPanel Grid.Column="0"><TextBlock Text="Self-heal size" FontSize="11"/><NumericUpDown Value="{Binding SelfHealSize}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Self-heal X offset" FontSize="11"/><NumericUpDown Value="{Binding SelfHealX}" Minimum="-2000" Maximum="2000" Increment="1" FormatString="0" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Self-heal Y offset" FontSize="11"/><NumericUpDown Value="{Binding SelfHealY}" Minimum="-2000" Maximum="2000" Increment="1" FormatString="0" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Heal Alerts -->
            <TabItem Header="Heal Alerts">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Shows a directional indicator when a heal or damage event lands — separate from the floating numbers and larger in scale. Damage indicator color supports __DEFAULT__ to keep the game's built-in color." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                    <CheckBox Content="Enabled" IsChecked="{Binding HealAlertEnabled}" />
                    <Grid ColumnDefinitions="*,8,*">
                        <v:ColorPickerField Grid.Column="0" Label="Damage color" ColorHex="{Binding HealAlertDamageColor}" />
                        <v:ColorPickerField Grid.Column="2" Label="Heal color"   ColorHex="{Binding HealAlertHealColor}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,8,*,8,*,8,*">
                        <StackPanel Grid.Column="0"><TextBlock Text="Damage size" FontSize="11"/><NumericUpDown Value="{Binding HealAlertDamageSize}" Minimum="0.25" Maximum="10" Increment="0.05" FormatString="0.00" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Heal size" FontSize="11"/><NumericUpDown Value="{Binding HealAlertHealSize}" Minimum="0.25" Maximum="10" Increment="0.05" FormatString="0.00" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Alpha" FontSize="11"/><NumericUpDown Value="{Binding HealAlertAlpha}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Text="Min heal" FontSize="11"/><NumericUpDown Value="{Binding HealAlertMinimumHeal}" Minimum="0" Maximum="1000" Increment="1" FormatString="0" /></StackPanel>
                    </Grid>
                    <CheckBox Content="Show direction" IsChecked="{Binding HealAlertShowDirection}" />
                </StackPanel>
            </TabItem>

            <!-- Friendly Low Health -->
            <TabItem Header="Low Health">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Changes the health bar and name color of friendly players when their health drops below a configurable threshold. The direction indicator shows where the low-health ally is on screen." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                    <CheckBox Content="Enabled" IsChecked="{Binding FriendlyLowHealthEnabled}" />
                    <Grid ColumnDefinitions="160,8,*">
                        <v:ColorPickerField Grid.Column="0" Label="Alert color" ColorHex="{Binding FriendlyLowHealthColor}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Threshold (0–1)" FontSize="11" />
                            <NumericUpDown Value="{Binding FriendlyLowHealthThreshold}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Show direction indicator" IsChecked="{Binding FriendlyLowHealthIndicator}" />
                    <Grid ColumnDefinitions="*,8,*">
                        <StackPanel Grid.Column="0"><TextBlock Text="Indicator size" FontSize="11"/><NumericUpDown Value="{Binding FriendlyLowHealthIndicatorSize}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Indicator alpha" FontSize="11"/><NumericUpDown Value="{Binding FriendlyLowHealthIndicatorAlpha}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Shield Timer -->
            <TabItem Header="Shield Timer">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Countdown timer for the shield buff bar. Circle mode draws a clock-style ring, numeric shows a number, off hides it. Offsets move the element relative to its default screen position." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                    <CheckBox Content="Enabled" IsChecked="{Binding ShieldEnabled}" />
                    <Grid ColumnDefinitions="160,8,*">
                        <v:ColorPickerField Grid.Column="0" Label="Bar color" ColorHex="{Binding ShieldColor}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Display mode" FontSize="11" />
                            <ComboBox ItemsSource="{Binding ShieldDisplayModes}" SelectedItem="{Binding ShieldDisplayMode}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,8,*,8,*">
                        <StackPanel Grid.Column="0"><TextBlock Text="Clock size" FontSize="11"/><NumericUpDown Value="{Binding ShieldSize}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Offset X" FontSize="11"/><NumericUpDown Value="{Binding ShieldOffsetX}" Minimum="-500" Maximum="500" Increment="1" FormatString="0" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Offset Y" FontSize="11"/><NumericUpDown Value="{Binding ShieldOffsetY}" Minimum="-500" Maximum="500" Increment="1" FormatString="0" /></StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- Misc (no color options) -->
            <TabItem Header="Misc">
                <ScrollViewer>
                    <StackPanel Margin="8" Spacing="6">

                        <!-- Aim healthbar -->
                        <CheckBox Content="Aim healthbar" IsChecked="{Binding AimHealthbarEnabled}" />
                        <TextBlock Text="Shows the enemy health bar whenever your crosshair is aimed at them, even if they haven't taken damage yet." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Deathcam healthbar -->
                        <CheckBox Content="Deathcam healthbar" IsChecked="{Binding DeathCamHealthbarEnabled}" />
                        <TextBlock Text="Shows friendly health bars when spectating teammates during the death cam." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Local build preview -->
                        <CheckBox Content="Local build preview" IsChecked="{Binding LocalBuildPreviewEnabled}" />
                        <TextBlock Text="Only enable if you have high ping. Blocks and devices appear on your screen immediately when placed, without waiting for server confirmation — eliminating the visual delay caused by network latency." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Auto casual queue -->
                        <CheckBox Content="Auto casual queue" IsChecked="{Binding AutoCasualQueueEnabled}" />
                        <TextBlock Text="Automatically joins the casual matchmaking queue as soon as you enter a custom game lobby, and auto-accepts the match popup when a game is found — pulling you out of the custom game into the casual match." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Teammate HP -->
                        <CheckBox Content="Teammate HP display" IsChecked="{Binding TeammateHpEnabled}" />
                        <TextBlock Text="Shows each teammate's current HP next to their name in the team panel while you are alive." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                        <CheckBox Content="Hide teammate name background" IsChecked="{Binding TeammateHideNameBackground}" />
                        <TextBlock Text="Removes the dark rectangle shown behind teammate names in the top-left team HUD. Uses a runtime UI heuristic and requires rebuild to apply." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Auto-crouch -->
                        <CheckBox Content="Disable auto-crouch" IsChecked="{Binding AutoCrouchEnabled}" />
                        <TextBlock Text="Disables the forced-crouch behaviour that triggers when the ceiling is too low to stand. Can also be toggled in-game via the runtime menu." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Motion blur prototype -->
                        <CheckBox Content="Motion blur (prototype)" IsChecked="{Binding MotionBlurEnabled}" />
                        <TextBlock Text="Directional camera motion blur compiled for Unity 5.1. Strength controls the maximum streak length; center focus preserves clarity around the crosshair. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                        <Grid ColumnDefinitions="*,8,*,8,*" Margin="20 0 0 4">
                            <StackPanel Grid.Column="0"><TextBlock Text="Strength" FontSize="11"/><NumericUpDown Value="{Binding MotionBlurStrength}" Minimum="0.1" Maximum="2" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Quality" FontSize="11"/><ComboBox ItemsSource="{Binding MotionBlurQualities}" SelectedItem="{Binding MotionBlurQuality}" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Center focus" FontSize="11"/><NumericUpDown Value="{Binding MotionBlurCenterFocus}" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                        </Grid>

                        <TextBlock Text="Color Grading / Sharpening" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <CheckBox Content="Enabled" IsChecked="{Binding VisualEnhancementsEnabled}" />
                        <TextBlock Text="Applies full-resolution sharpening and lightweight color grading to the world camera. Neutral values preserve the original colors. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                        <Grid ColumnDefinitions="*,8,*,8,*" Margin="20 0 0 4">
                            <StackPanel Grid.Column="0"><TextBlock Text="Sharpening" FontSize="11"/><NumericUpDown Value="{Binding VisualSharpening}" Minimum="0" Maximum="1.5" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Saturation" FontSize="11"/><NumericUpDown Value="{Binding VisualSaturation}" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Contrast" FontSize="11"/><NumericUpDown Value="{Binding VisualContrast}" Minimum="0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" /></StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,8,*" Margin="20 0 0 4">
                            <StackPanel Grid.Column="0"><TextBlock Text="Brightness" FontSize="11"/><NumericUpDown Value="{Binding VisualBrightness}" Minimum="0.5" Maximum="1.5" Increment="0.05" FormatString="0.00" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Temperature" FontSize="11"/><NumericUpDown Value="{Binding VisualTemperature}" Minimum="-1" Maximum="1" Increment="0.05" FormatString="0.00" /></StackPanel>
                        </Grid>

                        <!-- Segmented healthbar -->
                        <CheckBox Content="Segmented healthbar" IsChecked="{Binding SegmentedHealthbarEnabled}" />
                        <TextBlock Text="Replaces the overhead health bars with the segmented style from the beta version of the game. Requires the game to be installed — textures are copied into the game's CustomTextures folder on save." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <!-- Font override -->
                        <CheckBox Content="Font override (Edo SZ)" IsChecked="{Binding FontOverrideEnabled}" />
                        <TextBlock Text="Restores the stylized Edo SZ font to kill feed messages and center-screen notices (e.g. &quot;You've killed...&quot;, &quot;Our cube is under attack!&quot;). Requires a feature bundle rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />

                        <TextBlock Text="Objective Beam" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Adds a tall vertical beam above the capture objective so it is visible from anywhere on the map. No additional options — this is a simple enable/disable toggle." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled"   IsChecked="{Binding ObjectiveBeamEnabled}" />
                        <CheckBox Content="Hide beam" IsChecked="{Binding ObjectiveBeamHide}" />

                        <TextBlock Text="Unit GUI Scale" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Scales the healthbar and name label shown above all units (friendlies and enemies). Use values below 1.0 to shrink them for a cleaner view. Adjustable in-game via F8." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding UnitGuiScaleEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Scale" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding UnitGuiScale}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" Width="120" />
                        </StackPanel>

                        <TextBlock Text="WSI Scale" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Scales the world-space indicators (WSI) shown above units in the game world. Adjustable in-game via F8." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding WsiScaleEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Scale" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding WsiScale}" Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" Width="120" />
                        </StackPanel>

                        <TextBlock Text="Map Render" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Override the map's environmental lighting preset. &quot;Default&quot; uses the map's own preset. Cycle through options in-game via F8." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding MapRenderEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Preset" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding MapRenderPresets}" SelectedItem="{Binding MapRenderPreset}" Width="160" />
                        </StackPanel>

                        <TextBlock Text="Hide Impact VFX" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Suppress explosion and impact visual effects (bombs, rockets, grenades, cannons, etc.). Only the visual particles are hidden — sound and damage still apply." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled"               IsChecked="{Binding HideImpactVfxEnabled}" />
                        <CheckBox Content="Hide impact VFX"       IsChecked="{Binding HideImpactVfx}" />
                        <CheckBox Content="Hide lava/water plane"  IsChecked="{Binding HideLavaWaterPlane}" />
                        <CheckBox Content="Hide falling blocks"   IsChecked="{Binding HideFallingBlocks}" />

                        <TextBlock Text="Optimize Device Health Bars" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Reduces CPU cost on device-heavy maps. Skips distant device health bars entirely, skips full-HP devices each frame, and short-circuits the healthbar update loop when nothing has changed. Throttles minimap, team-overlay WSI, and gravity trap updates, and fully disables fan animators and front player indicators. Keeps player, base, shield-generator, objective, and other always-relevant health bars unaffected. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding PerformanceOptEnabled}" />

                        <TextBlock Text="Performance Telemetry" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Continuously records every rendered frame only while inside a match (the Zone scene). Lobby, loading, and menu frames are excluded. Binary traces are saved under BlockNLoad_Data/bnl-performance-logs. Give each experiment a distinct label. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding PerformanceTelemetryEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Test label" VerticalAlignment="Center" />
                            <TextBox Text="{Binding PerformanceTelemetryLabel}" Width="180" />
                            <TextBlock Text="Warmup" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding PerformanceTelemetryWarmup}" Minimum="0" Maximum="60" Increment="1" Width="140" MinWidth="140" />
                        </StackPanel>

                        <TextBlock Text="Minimap Performance Opt (Test)" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Reduces continuous minimap CPU and allocation cost by updating camera bounds, layout, and unit reconciliation at a fixed, staggered rate independent of game FPS. Icon animation, the map-render coroutine, and gameplay state are unchanged. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding MinimapPerformanceEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Update rate" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding MinimapPerformanceHz}" Minimum="10" Maximum="60" Increment="5" Width="140" MinWidth="140" />
                            <TextBlock Text="Hz" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="World-Space Indicator Performance Opt (Test)" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Runs friendly unit scanning and WSI population reconciliation at a fixed rate. Existing overhead indicators continue tracking their targets normally. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding WsiPerformanceEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Reconciliation rate" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding WsiPerformanceHz}" Minimum="5" Maximum="60" Increment="5" Width="140" MinWidth="140" />
                            <TextBlock Text="Hz" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="In-Game FPS Counter" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Shows a smoothed FPS counter in the top-right corner during matches only. The text refresh is rate-limited to avoid per-frame string allocations. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding FpsCounterEnabled}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Display refresh" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding FpsCounterRefreshHz}" Minimum="1" Maximum="20" Increment="1" Width="140" MinWidth="140" />
                            <TextBlock Text="Hz" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Enable Time Assault" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Forces the Time Assault menu entry to stay visible and enabled even when the live server disables it. Uses the game's existing Time Trial UI and `StartTimeTrial()` network path so the mode can be tested if the backend still accepts it. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <CheckBox Content="Enabled" IsChecked="{Binding TimeAssaultEnabled}" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Skins -->
            <TabItem Header="Skins">
                <ScrollViewer>
                    <StackPanel Margin="8" Spacing="5">
                        <TextBlock Text="Cosmetic replacements are organized by hero. Expand a hero, then choose Skins or Weapon Models." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0 0 0 4" />

                        <Expander Header="Yeti" IsExpanded="True">
                            <TabControl Margin="12 4 0 6">
                                <TabItem Header="Skins">
                                    <StackPanel Margin="8" Spacing="4">
                                        <TextBlock Text="Hindu Yeti" FontWeight="SemiBold" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding HinduYetiSkinEnabled}" />
                                        <TextBlock Text="Replaces Yeti's S1 body, first-person arms, snow weapons, and ice effects with the Hindu Yeti texture set. Other Yeti skins, geometry, animations, and hitboxes remain unchanged. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem>
                            </TabControl>
                        </Expander>
                        <Expander Header="Astarella"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Cogwheel"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Dream Genie"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="'Doc' Eliza Doolally"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Kira-Chan"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Kreepy the Clown"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>

                        <Expander Header="Nigel Purdey-Longshot">
                            <TabControl Margin="12 4 0 6">
                                <TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem>
                                <TabItem Header="Weapon Models">
                                    <StackPanel Margin="8" Spacing="4">
                                        <TextBlock Text="Imported No-Hammers Rifle" FontWeight="SemiBold" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding NigelSniperVisualEnabled}" />
                                        <TextBlock Text="Replaces Nigel's base rifle mesh with the imported no-hammers model. Hands, player skeleton, and default animations remain unchanged. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Expander>

                        <Expander Header="Vander Graaf" IsExpanded="True">
                            <TabControl Margin="12 4 0 6">
                                <TabItem Header="Skins">
                                    <StackPanel Margin="8" Spacing="4">
                                        <TextBlock Text="Blue" FontWeight="SemiBold" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding VanderBlueSkinEnabled}" />
                                        <TextBlock Text="Replaces Vander's default third-person body and first-person arms with the Blue texture set. Geometry, animations, weapons, and hitboxes remain unchanged. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem>
                            </TabControl>
                        </Expander>

                        <Expander Header="O.P. Juan Shinobi" IsExpanded="True">
                            <TabControl Margin="12 4 0 6">
                                <TabItem Header="Skins">
                                    <StackPanel Margin="8" Spacing="4">
                                        <TextBlock Text="Turtle" FontWeight="SemiBold" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding NinjaTurtleSkinEnabled}" />
                                        <TextBlock Text="Replaces Ninja's default third-person body, first-person arms, and katana textures with the Turtle texture set. Geometry, animations, and hitboxes remain unchanged. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem>
                            </TabControl>
                        </Expander>

                        <Expander Header="Roly Poly Fat Fat"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Sarge Stone"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Sweet Science" IsExpanded="True">
                            <TabControl Margin="12 4 0 6">
                                <TabItem Header="Skins">
                                    <StackPanel Margin="8" Spacing="4">
                                        <TextBlock Text="Darklord SS" FontWeight="SemiBold" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding DarklordSweetScienceSkinEnabled}" />
                                        <TextBlock Text="Replaces the Devil SS body and first-person arms, including Blitz and Graviton states, with the Darklord SS texture set. Other Sweet Science skins, geometry, animations, and hitboxes remain unchanged. Requires rebuild." TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20 0 0 4" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem>
                            </TabControl>
                        </Expander>
                        <Expander Header="Trondson"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                        <Expander Header="Anthony 'Tony' Turretto"><TabControl Margin="12 4 0 6"><TabItem Header="Skins"><TextBlock Text="No custom skins available yet." Margin="8" Foreground="Gray" /></TabItem><TabItem Header="Weapon Models"><TextBlock Text="No custom weapon models available yet." Margin="8" Foreground="Gray" /></TabItem></TabControl></Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Bot / Offline Practice Mode -->
            <TabItem Header="Bot Mode">
                <ScrollViewer>
                    <StackPanel Margin="8" Spacing="8">

                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                            Offline practice mode — fight AI bots without a server connection. When enabled, the game
                            skips the login flow, loads a map from the local catalogue, and spawns bot opponents
                            controlled by the launcher's AI driver. Bots use A* pathfinding to navigate the map,
                            shoot with their primary weapon, and retreat when low on health.
                            Requires a feature bundle rebuild to apply the IL patches.
                        </TextBlock>

                        <CheckBox Content="Enabled" IsChecked="{Binding BotModeEnabled}" />

                        <TextBlock Text="Warning: enabling this bypasses Steam login entirely. The game will not connect to any server while Bot Mode is active." TextWrapping="Wrap" Foreground="#FFAA44" FontSize="11" />

                        <TextBlock Text="Bot count" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="How many AI opponents to spawn on the enemy team (1–9)." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <NumericUpDown Value="{Binding BotModeCount}" Minimum="1" Maximum="9" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" />

                        <TextBlock Text="Difficulty" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
                            Easy — slow reactions (1.5 s delay), wide aim spread (3 units).
                            Medium — moderate reactions (0.6 s), small spread (1.2 units).
                            Hard — near-instant reactions (0.1 s), precise aim (0.2 units).
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding BotDifficulties}" SelectedItem="{Binding BotModeDifficulty}" Width="160" HorizontalAlignment="Left" />

                        <TextBlock Text="Map key" FontWeight="SemiBold" Margin="0 8 0 0" />
                        <TextBlock Text="Leave as 'default' to let the runtime pick the first available Friendly map (falling back to Tutorial). Enter a specific catalogue map key to force a particular map." TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                        <TextBox Text="{Binding BotModeMap}" Width="260" HorizontalAlignment="Left" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
