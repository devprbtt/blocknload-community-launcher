<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BnlCommunityFixes.Avalonia.ViewModels"
        x:Class="BnlCommunityFixes.Avalonia.Views.CustomServerManagerWindow"
        x:DataType="vm:CustomServerManagerViewModel"
        Title="Custom Servers"
        Width="740" Height="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid ColumnDefinitions="280,*" Margin="14">
        <!-- Server list -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Servers}"
                 SelectedItem="{Binding SelectedServer}"
                 Margin="0 0 12 0" />

        <!-- Edit panel -->
        <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Key" FontSize="11" />
            <TextBox Text="{Binding Key}" />
            <TextBlock Text="Name" FontSize="11" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Text="Host" FontSize="11" />
            <TextBox Text="{Binding Host}" />
            <Grid ColumnDefinitions="*,12,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Port" FontSize="11" />
                    <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Patch" FontSize="11" />
                    <TextBox Text="{Binding Patch}" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,8,*,8,*" Margin="0 8 0 0">
                <Button Grid.Column="0" Content="Save"   Command="{Binding SaveCommand}"   HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="4" Content="Close"  Click="Close_Click"               HorizontalAlignment="Stretch" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
