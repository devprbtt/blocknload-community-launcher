<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BnlCommunityFixes.Avalonia.Views.MessageDialog"
        Title="Block N Load Community Fixes V2"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="20 16 20 16" Spacing="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Button Content="OK" HorizontalAlignment="Right" Width="80" Click="Ok_Click" />
    </StackPanel>

</Window>
