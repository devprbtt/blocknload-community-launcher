<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BnlCommunityFixes.Avalonia.Views.ConfirmDialog"
        Title="Block N Load Community Fixes V2"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16 14 16 14" Spacing="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="No"  Click="No_Click"  Width="72" />
            <Button Content="Yes" Click="Yes_Click" Width="72" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
