<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BnlCommunityFixes.Core\BnlCommunityFixes.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.4.8</Version>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BnlCommunityFixes</AssemblyName>
    <RootNamespace>BnlCommunityFixes.Launcher</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>launcher-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="launcher-icon.ico" />
    <EmbeddedResource Include="game-icon.ico" />
    <EmbeddedResource Include="..\..\assets\patching\Build-ExperimentalCrosshairAssembly.ps1" LogicalName="Patching.Build-ExperimentalCrosshairAssembly.ps1" />
    <EmbeddedResource Include="..\..\assets\patching\CrosshairBundleRuntime.cs" LogicalName="Patching.CrosshairBundleRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\RuntimeMenu.cs" LogicalName="Patching.RuntimeMenu.cs" />
    <EmbeddedResource Include="..\..\assets\patching\MatchReplayRecorderRuntime.cs" LogicalName="Patching.MatchReplayRecorderRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\ReplayPlayerRuntime.cs" LogicalName="Patching.ReplayPlayerRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\experimental-debug-menu-config.json" LogicalName="Patching.experimental-debug-menu-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\experimental-match-replay-recorder-config.json" LogicalName="Patching.experimental-match-replay-recorder-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\experimental-auto-casual-queue-config.json" LogicalName="Patching.experimental-auto-casual-queue-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\friendly-low-health-config.json" LogicalName="Patching.friendly-low-health-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\teammate-hp-config.json" LogicalName="Patching.teammate-hp-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\experimental-auto-crouch-config.json" LogicalName="Patching.experimental-auto-crouch-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\unit-gui-scale-config.json" LogicalName="Patching.unit-gui-scale-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\experimental-map-render-config.json" LogicalName="Patching.experimental-map-render-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\AudioReplacerRuntime.cs" LogicalName="Patching.AudioReplacerRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\experimental-audio-replacer-config.json" LogicalName="Patching.experimental-audio-replacer-config.json" />
    <EmbeddedResource Include="..\..\assets\patching\Mono.Cecil.dll" LogicalName="Patching.Mono.Cecil.dll" />
  </ItemGroup>

</Project>
