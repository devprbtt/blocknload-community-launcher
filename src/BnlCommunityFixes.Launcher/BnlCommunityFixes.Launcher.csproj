    <EmbeddedResource Include="..\..\assets\patching\TeammateHpRuntime.template.cs" LogicalName="Patching.TeammateHpRuntime.template.cs" />
    <EmbeddedResource Include="..\..\assets\patching\FontOverrideRuntime.template.cs" LogicalName="Patching.FontOverrideRuntime.template.cs" />
    <EmbeddedResource Include="..\..\assets\patching\RuntimeMenu.cs" LogicalName="Patching.RuntimeMenu.cs" />
    <EmbeddedResource Include="..\..\assets\patching\MatchReplayRecorderRuntime.cs" LogicalName="Patching.MatchReplayRecorderRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\ReplayPlayerRuntime.cs" LogicalName="Patching.ReplayPlayerRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\AutoCrouchRuntime.cs" LogicalName="Patching.AutoCrouchRuntime.cs" />
