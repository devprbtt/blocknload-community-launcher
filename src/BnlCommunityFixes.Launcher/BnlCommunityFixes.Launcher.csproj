<!-- Windows-only WinForms launcher. For cross-platform (Linux/macOS), use BnlCommunityFixes.Avalonia instead. -->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BnlCommunityFixes.Core\BnlCommunityFixes.Core.csproj" />
    <ProjectReference Include="..\BnlCommunityFixes.ReplayAnalyzer\BnlCommunityFixes.ReplayAnalyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.6.5</Version>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BnlCommunityFixes</AssemblyName>
    <RootNamespace>BnlCommunityFixes.Launcher</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>launcher-icon.ico</ApplicationIcon>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Include="launcher-icon.ico" />
    <EmbeddedResource Include="game-icon.ico" />
    <EmbeddedResource Include="..\..\assets\patching\Build-ExperimentalCrosshairAssembly.ps1" LogicalName="Patching.Build-ExperimentalCrosshairAssembly.ps1" />
    <EmbeddedResource Include="..\..\assets\patching\CrosshairBundleRuntime.cs" LogicalName="Patching.CrosshairBundleRuntime.cs" />
    <EmbeddedResource Include="..\..\assets\patching\HelperBase.template.cs" LogicalName="Patching.HelperBase.template.cs" />
